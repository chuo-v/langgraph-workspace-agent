# ==========================================
# LLM Tiering
# ==========================================
# Tier 1 (Local): Managed entirely via Ollama (No keys required)
OLLAMA_API_BASE="http://host.docker.internal:11434"

# Tier 2 (Cheap Cloud):
# options: "deepseek" or "openai"
STANDARD_PROVIDER="deepseek"
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""

# Tier 3 (Frontier Cloud):
# options: "anthropic" or "gemini"
FRONTIER_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# ==========================================
# GitHub Integrations
# ==========================================
# Your GitHub account username used for identifying repositories
GITHUB_USERNAME="your_github_username"
# Fine-grained PAT with 'Contents' and 'Pull Requests' permissions
GITHUB_TOKEN="github_pat_..."
# Required for PR event verification
GITHUB_WEBHOOK_SECRET="your_custom_webhook_secret_string"

# ==========================================
# Telegram Webhook
# ==========================================
# Telegram Bot API Token (from BotFather)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Personal Telegram Chat ID (to restrict access)
AUTHORIZED_OWNER_CHAT_ID="your_personal_chat_id"
# Must match the secret_token used in setWebhook
TELEGRAM_SECRET_TOKEN="a_secure_random_string_for_webhook_auth"

# ==========================================
# Cloudflare Ingress Tunnel
# ==========================================
# The secure token generated via Cloudflare Zero Trust dashboard for the gateway tunnel
CLOUDFLARE_TUNNEL_TOKEN="your_cloudflare_tunnel_token_here"

# ==========================================
# Agent Configuration Path
# ==========================================
# Absolute path to your private deployment's config.yaml.
# If left blank, defaults to the config.yaml in this repository.
# Example: /Users/username/git/langgraph-workspace-agent-deployment/config.yaml
WORKSPACE_AGENT_CONFIG_PATH=""

# ==========================================
# Filesystem Configuration
# ==========================================
# The absolute path on your host machine where your repositories are stored.
# This directory will be mounted symmetrically into the agent container.
# Example: /Users/username/git or C:/Users/username/projects
HOST_WORKSPACE_DIR="/Users/your_username/git"

# ==========================================
# Observability (Langfuse Local Stack)
# ==========================================
# Generate these in your local Langfuse dashboard (http://localhost:3000)
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
# Default for local docker-compose stack
LANGFUSE_HOST="http://localhost:3000"

# ==========================================
# Infrastructure Secrets (Docker Compose)
# ==========================================
POSTGRES_PASSWORD="langfuse_dev_postgres"
CLICKHOUSE_PASSWORD="langfuse_dev_clickhouse"
MINIO_ROOT_PASSWORD="langfuse_dev_minio"

# Cryptographic keys for Langfuse UI sessions
LANGFUSE_NEXTAUTH_SECRET="my_super_secret_nextauth_string_for_local_dev"
LANGFUSE_SALT="my_super_secret_salt_string_for_local_dev"

# ==========================================
# Docker Socket Permissions (Linux Only)
# ==========================================
# If running natively on Linux, the orchestrator needs permission to communicate
# with the host's Docker daemon. Set this to your user's UID and the host's 'docker' group GID.
# You can find these by running `id -u` and `getent group docker | cut -d: -f3`.
# Example: GATEWAY_USER="1000:999"
#
# Note: macOS and Windows users (Docker Desktop/OrbStack) should leave this blank.
GATEWAY_USER=""