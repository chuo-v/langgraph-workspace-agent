FROM python:3.11-slim

# install LaTeX and build tools
RUN apt-get update && apt-get install -y \
    texlive-latex-base \
    texlive-fonts-recommended \
    texlive-latex-extra \
    latexmk \
    && rm -rf /var/lib/apt/lists/*

# set the working directory
WORKDIR /workspace

# Keep the container lightweight; dependencies can be installed
# dynamically by the agent if needed via pip inside the script.